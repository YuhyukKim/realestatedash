# Collector-only; public Worker reads stored D1 data.
MOLIT_API_KEY=
NEIS_API_KEY=
NAVER_MAP_CLIENT_ID=
# Canonical HTTPS origin after domain ownership and routing are verified.
PUBLIC_SITE_URL=
# Server-only, random token (at least 32 characters) for POST /api/complexes and /api/admin/trade-import.
# Never use NEXT_PUBLIC_ or put this in a URL.
DATA_REFRESH_TOKEN=

# Collector process / GitHub Actions (not browser variables).
MOLIT_DISTRICTS=
MOLIT_FROM=
MOLIT_TO=
MOLIT_KIND=both
# Opt-in GitHub repository variable; enable only after verification.
MOLIT_SCHEDULE_ENABLED=false
